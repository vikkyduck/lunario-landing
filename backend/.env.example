# /opt/lunario/.env — боевые значения на сервере, файл не попадает в rsync
PORT=5030
SITE_DIR=/opt/lunario/site
DB_FILE=/opt/lunario/data/lunario.db
PUBLIC_BASE=https://lunario.online

# Telegram-уведомления (без персональных данных). Токен вводит владелица: ./set-tg.sh
TG_BOT_TOKEN=
# Один id или несколько через запятую (личный чат + общий чат команды):
# TG_CHAT_ID=123456789,-1001234567890
TG_CHAT_ID=
# Если api.telegram.org недоступен с VDS — CF-прокси, как в withoutwater
TELEGRAM_API_BASE=https://api.telegram.org

# Админка /admin (basic auth). Пароль сгенерировать: openssl rand -base64 18
ADMIN_USER=lunario
ADMIN_PASS=

# Яндекс.Метрика: счётчик «Лунарио — lunario.online» (создан 2026-08-05,
# цели: lead_sent — главная, cta_click, form_start)
METRIKA_ID=111318632
